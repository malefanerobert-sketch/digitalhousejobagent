# Copy this file to ".env" and fill in real values. Never commit the real .env file.

# Supabase project: digitalhouse-jobagent
SUPABASE_URL=https://celylskveytdwvuvsuvx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste_the_service_role_key_here

# How often the discovery job checks for new postings (cron syntax). Default: every hour.
DISCOVER_CRON=0 * * * *

# How often the apply job processes approved/automatic matches. Default: every 20 minutes.
APPLY_CRON=*/20 * * * *

# Safety limits — keeps the worker from hammering any single job board too fast
# and looking bot-like. Milliseconds of delay between actions.
MIN_ACTION_DELAY_MS=4000
MAX_ACTION_DELAY_MS=11000

# Max applications submitted per run, across all users, as a safety brake
MAX_APPLICATIONS_PER_RUN=15

# 2Captcha API key — enables automatic CAPTCHA solving on job-application
# forms (reCAPTCHA v2/v3, hCaptcha, Cloudflare Turnstile). Sign up at
# https://2captcha.com and top up (min $3). If unset, the worker still runs
# but any CAPTCHA-guarded application is logged as "captcha_blocked".
CAPTCHA_API_KEY=
