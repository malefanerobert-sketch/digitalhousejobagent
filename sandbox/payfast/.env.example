# Copy to .env locally. Never commit the populated file.
# This harness has no live mode. Do not use live merchant credentials.
PAYFAST_MODE=sandbox
SANDBOX_MERCHANT_ID=
SANDBOX_MERCHANT_KEY=
SANDBOX_PASSPHRASE=
# Generate an unrelated operator login key (at least 32 random characters).
# This is NOT a PayFast credential. Keep private.
SANDBOX_ACCESS_KEY=
# Dedicated HTTPS staging origin, NOT the production JobAgent domain.
# Leave blank until an isolated staging origin is available.
SANDBOX_PUBLIC_ORIGIN=
# Server listens on loopback by default; reverse proxy must preserve Host/Origin.
HOST=127.0.0.1
PORT=8787
# Comma-separated exact proxy IPs ONLY if behind a trusted reverse proxy.
# Never trust arbitrary X-Forwarded-For. Do not use 0.0.0.0 here.
SANDBOX_TRUSTED_PROXY_IPS=
